{% extends "base.html.j2" %}
{% block content %}
<h1>词典管理</h1>

<!-- Search -->
<div style="margin-bottom: var(--space-lg);">
  <input type="search" name="search" placeholder="搜索术语（英文或中文）..."
         hx-get="/glossary" hx-trigger="keyup changed delay:300ms"
         hx-target="#term-table" hx-swap="innerHTML"
         value="{{ search }}"
         style="width: 100%; max-width: 400px;">
</div>

<!-- Term table (grouped by map) -->
<div id="term-table">
  {% if grouped_terms %}
    {% for group_name, group_terms in grouped_terms %}
    <details open style="margin-bottom:var(--space-lg);">
      <summary style="cursor:pointer;font-weight:600;padding:var(--space-sm) 0;font-size:1.05em;">
        {% if group_name == 'user' %}
          ✏️ 用户自定义
        {% elif group_name == '其他' %}
          📁 其他
        {% else %}
          🗺️ {{ group_name }}
        {% endif %}
        <span style="color:var(--color-text-secondary);font-weight:400;">
          · {{ group_terms|length }} 个术语
        </span>
      </summary>
      <table style="margin-top:var(--space-sm);">
        <thead>
          <tr>
            <th>英文术语</th>
            <th>中文翻译</th>
            <th>分类</th>
            <th>别名</th>
            <th style="width:60px;">操作</th>
          </tr>
        </thead>
        <tbody>
          {% for term in group_terms %}
          {# Use a unique ID: group_index + term_index #}
          <tr id="term-{{ term._flat_idx }}">
            <td><strong>{{ term.en }}</strong></td>
            <td>{{ term.zh }}</td>
            <td><span class="badge badge-{{ term.category }}">{{ term.category }}</span></td>
            <td style="color:var(--color-text-secondary);font-size:0.9em;">{{ term.aliases | join(', ') }}</td>
            <td style="white-space:nowrap;">
              {% if term.source == 'user' %}
              <button onclick="editGlossaryTerm({{ term._flat_idx }})"
                      style="background:transparent;color:var(--color-text-secondary);" title="编辑">✏️</button>
              <button hx-delete="/glossary/delete/{{ term._flat_idx }}"
                      hx-target="#term-{{ term._flat_idx }}" hx-swap="outerHTML"
                      hx-confirm="确定删除 '{{ term.en }}'？"
                      style="background:transparent;color:var(--color-accent);" title="删除">🗑</button>
              {% else %}
              <span style="color:var(--color-text-secondary);font-size:0.8em;" title="系统术语不可删除">🔒</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    {% endfor %}

    <p style="color:var(--color-text-secondary);font-size:0.9em;">
      共 {{ total }} 个术语 · {{ grouped_terms|length }} 个分组
    </p>
  {% else %}
  <div class="empty-state">
    {% if search %}
    <p>没有找到匹配 "{{ search }}" 的术语。</p>
    {% else %}
    <p>词典为空。</p>
    <p style="color:var(--color-text-secondary);">
      请确保词典目录存在（项目 <code>dictionaries/</code> 或 <code>~/.cs2tl/dictionaries/</code>），<br>
      其中包含地图子目录（如 <code>de_dust2/zones.yml</code>）。
    </p>
    {% endif %}
  </div>
  {% endif %}
</div>

<!-- Add term form -->
<details style="margin-top: var(--space-lg);">
  <summary style="cursor:pointer;color:var(--color-accent);">+ 新增术语</summary>
  <form hx-post="/glossary/add" hx-target="#term-table" hx-swap="innerHTML"
        style="margin-top:var(--space-md);padding:var(--space-md);background:var(--color-bg-secondary);border-radius:var(--radius-md);">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md);">
      <div>
        <label style="display:block;margin-bottom:var(--space-xs);">英文术语 *</label>
        <input name="en" placeholder="如：AWP" required style="width:100%;">
      </div>
      <div>
        <label style="display:block;margin-bottom:var(--space-xs);">中文翻译 *</label>
        <input name="zh" placeholder="如：大狙" required style="width:100%;">
      </div>
      <div>
        <label style="display:block;margin-bottom:var(--space-xs);">别名（逗号分隔）</label>
        <input name="aliases" placeholder="如：awp, AWP" style="width:100%;">
      </div>
      <div>
        <label style="display:block;margin-bottom:var(--space-xs);">分类</label>
        <select name="category" style="width:100%;">
          <option value="weapon">武器</option>
          <option value="utility">道具</option>
          <option value="tactic">战术</option>
          <option value="position">位置</option>
          <option value="other">其他</option>
        </select>
      </div>
    </div>
    <button type="submit" style="margin-top:var(--space-md);">新增术语</button>
  </form>
</details>

<!-- Save: git push -->
<div style="margin-top: var(--space-xl); padding: var(--space-md); background: var(--color-bg-secondary); border-radius: var(--radius-md); display: flex; align-items: center; gap: var(--space-md);">
  <button hx-post="/glossary/save" hx-target="#save-status" hx-swap="innerHTML">
    💾 保存并推送到 GitHub
  </button>
  <span id="save-status"></span>
</div>

<p style="color:var(--color-text-secondary);font-size:0.85em;margin-top:var(--space-md);">
  💡 用户添加的术语保存在词典目录的 <code>common/glossary.yml</code> 中。<br>
  翻译管线会自动加载系统词典 + 用户术语——新增或修改后需要重新翻译才能看到效果。
</p>
{% endblock %}
