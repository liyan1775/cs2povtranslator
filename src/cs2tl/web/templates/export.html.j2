{% extends "base.html.j2" %}
{% block content %}
<h1>导出字幕</h1>

<!-- Stats card — third relief point -->
<div class="stats-card" style="margin-bottom: var(--space-lg);">
  <h2 style="margin-top:0;">📊 翻译摘要</h2>
  <ul>
    <li>总片段：<strong>{{ stats.total }}</strong> 条</li>
    <li>已翻译：<strong style="color:var(--color-success);">{{ stats.translated }}</strong> 条</li>
    <li>词典术语命中：<strong>{{ stats.dict_hits }}</strong> 条</li>
    <li>手动编辑：<strong>{{ stats.edited }}</strong> 条</li>
    {% if stats.failed > 0 %}
    <li style="color:var(--color-accent);">翻译失败：<strong>{{ stats.failed }}</strong> 条（已保留原文）</li>
    {% else %}
    <li style="color:var(--color-success);">翻译失败：<strong>0</strong> 条</li>
    {% endif %}
    {% if stats.skipped_frames > 0 %}
    <li style="color:var(--color-text-secondary);">⚠️ 音频解码跳过 {{ stats.skipped_frames }} 帧（不影响翻译质量）</li>
    {% endif %}
  </ul>
</div>

<!-- Download buttons -->
<div style="display: flex; gap: var(--space-md); margin-bottom: var(--space-lg);">
  <a href="/export/{{ job_id }}/download/2" class="btn" style="padding:var(--space-md) var(--space-xl);font-size:1.1em;">
    📥 下载 Team 2 SRT
  </a>
  <a href="/export/{{ job_id }}/download/3" class="btn" style="padding:var(--space-md) var(--space-xl);font-size:1.1em;">
    📥 下载 Team 3 SRT
  </a>
</div>

<!-- SRT preview -->
{% if stats.preview %}
<details>
  <summary style="cursor:pointer;">预览前 20 条字幕</summary>
  <pre style="background:var(--color-bg-secondary);padding:var(--space-md);border-radius:var(--radius-sm);max-height:400px;overflow-y:auto;font-family:var(--font-mono);font-size:0.85em;line-height:1.5;white-space:pre-wrap;">{{ stats.preview }}</pre>
</details>
{% endif %}

<div style="margin-top: var(--space-xl); padding: var(--space-md); background: var(--color-bg-secondary); border-radius: var(--radius-md);">
  <p style="color:var(--color-text-secondary);font-size:0.9em;">
    📋 SRT 字幕采用双语格式——原文在上，译文在下。可以直接导入 剪映 / Premiere Pro。<br>
    💡 发布视频到 B站后，观众可通过弹幕/评论区反馈翻译错误 → 在词典页修正 → 重新翻译导出。
  </p>
</div>
{% endblock %}
