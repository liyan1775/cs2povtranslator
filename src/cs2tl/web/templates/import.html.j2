{% extends "base.html.j2" %}
{% block content %}
<h1>导入 Demo</h1>
<p style="color: var(--color-text-secondary);">支持 Faceit / 社区服务器 CS2 demo（.dem 或 .dem.zst）</p>

<form action="/import" method="post" enctype="multipart/form-data">
  <label class="upload-zone">
    <input type="file" name="demo" accept=".dem,.dem.zst" required
           style="display: block; width: 100%;"
           onchange="this.parentElement.querySelector('.file-name').textContent = this.files[0]?.name || '点击选择文件或拖拽到此处'">
    <span class="file-name" style="display:block;margin-top:var(--space-md);color:var(--color-text-secondary);">
      点击选择文件或拖拽到此处
    </span>
  </label>

  <button type="submit" style="margin-top: var(--space-lg); padding: var(--space-md) var(--space-xl); font-size: 1.1em;">
    开始翻译
  </button>
</form>

<script>
(function(){
  const zone = document.querySelector('.upload-zone');
  const input = zone.querySelector('input[type=file]');
  const nameEl = zone.querySelector('.file-name');
  ['dragenter','dragover','dragleave','drop'].forEach(ev => {
    zone.addEventListener(ev, e => { e.preventDefault(); e.stopPropagation(); });
  });
  ['dragenter','dragover'].forEach(ev => {
    zone.addEventListener(ev, () => zone.style.borderColor = 'var(--color-accent)');
  });
  ['dragleave','drop'].forEach(ev => {
    zone.addEventListener(ev, () => zone.style.borderColor = '');
  });
  zone.addEventListener('drop', e => {
    const files = e.dataTransfer.files;
    if (files.length) { input.files = files; nameEl.textContent = files[0].name; }
  });
})();
</script>

<div style="margin-top: var(--space-xl); padding: var(--space-lg); background: var(--color-bg-secondary); border-radius: var(--radius-md);">
  <h3 style="margin-top: 0;">📋 使用说明</h3>
  <ol style="color: var(--color-text-secondary); line-height: 2;">
    <li>选择 CS2 demo 文件（.dem 或 .dem.zst）</li>
    <li>点击「开始翻译」— 管线将自动运行 7 个阶段</li>
    <li>在进度页观察处理状态（可刷新页面，进度不丢失）</li>
    <li>完成后在预览页检查翻译质量，可编辑任何一条译文</li>
    <li>在词典页维护 CS 术语（新增、修改、删除）</li>
    <li>在导出页下载双语 SRT 字幕文件</li>
  </ol>
  <p style="color: var(--color-text-secondary);">
    ⏱️ 翻译一个 30 分钟的 demo 大约需要 5-10 分钟，具体取决于 Whisper 模型大小和 CPU 性能。<br>
    💡 提示：翻译过程中可以切换到词典标签页编辑术语，互不影响。
  </p>
</div>

{% if jobs %}
<div style="margin-top: var(--space-xl);">
  <h3>📋 历史任务</h3>
  <div style="display: flex; flex-direction: column; gap: var(--space-sm);">
  {% for job in jobs %}
    <div style="display: flex; align-items: center; justify-content: space-between;
                padding: var(--space-md); background: var(--color-bg-secondary);
                border-radius: var(--radius-md); border-left: 3px solid
                {% if job.status.value == 'completed' %}var(--color-accent)
                {% elif job.status.value == 'failed' %}#ef4444
                {% elif job.status.value == 'running' %}#f59e0b
                {% else %}var(--color-text-secondary){% endif %};">
      <div style="flex: 1; min-width: 0;">
        <div style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ job.demo_name }}
        </div>
        <div style="font-size: 0.85em; color: var(--color-text-secondary); margin-top: 2px;">
          {{ job.created_at[:10] }}
          {% if job.player_count %}
          · {{ job.player_count }} 名玩家
          {% endif %}
          {% if job.status.value == 'failed' and job.error %}
          · <span style="color: #ef4444;">{{ job.error[:80] }}</span>
          {% endif %}
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: var(--space-sm); flex-shrink: 0; margin-left: var(--space-md);">
        <span style="font-size: 0.85em; padding: 2px 8px; border-radius: var(--radius-sm);
                     {% if job.status.value == 'completed' %}background: #166534; color: #4ade80;
                     {% elif job.status.value == 'failed' %}background: #7f1d1d; color: #fca5a5;
                     {% elif job.status.value == 'running' %}background: #78350f; color: #fcd34d;
                     {% else %}background: var(--color-bg-primary); color: var(--color-text-secondary);{% endif %}">
          {% if job.status.value == 'completed' %}✅ 已完成
          {% elif job.status.value == 'failed' %}❌ 失败
          {% elif job.status.value == 'running' %}⏳ 进行中
          {% else %}{{ job.status.value }}
          {% endif %}
        </span>
        {% if job.status.value == 'completed' %}
        <a href="/preview/{{ job.job_id }}" class="btn-sm"
           style="padding: 4px 12px; background: var(--color-accent); color: white;
                  text-decoration: none; border-radius: var(--radius-sm); font-size: 0.85em;">
          查看预览
        </a>
        {% elif job.status.value == 'running' %}
        <a href="/progress/{{ job.job_id }}" class="btn-sm"
           style="padding: 4px 12px; background: #f59e0b; color: white;
                  text-decoration: none; border-radius: var(--radius-sm); font-size: 0.85em;">
          查看进度
        </a>
        {% elif job.status.value == 'failed' %}
        <span style="font-size: 0.8em; color: var(--color-text-secondary);">已中断</span>
        {% endif %}
      </div>
    </div>
  {% endfor %}
  </div>
</div>
{% else %}
<div style="margin-top: var(--space-xl); padding: var(--space-lg); background: var(--color-bg-secondary);
            border-radius: var(--radius-md); text-align: center; color: var(--color-text-secondary);">
  <p>还没有翻译过任何 demo。上传你的第一个 demo 开始翻译。</p>
</div>
{% endif %}
{% endblock %}
