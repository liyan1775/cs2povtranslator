{% extends "base.html.j2" %}
{% block content %}
<h1>翻译进度</h1>
<p style="color: var(--color-text-secondary);">任务 ID：{{ job_id }}</p>

{% if demo_info %}
<!-- First relief point: demo info card -->
<div class="stats-card" style="margin-bottom: var(--space-lg);">
  <h3 style="margin-top:0;">📋 {{ demo_info.filename }}</h3>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md);">
    <div>
      <strong>Team 2</strong>（{{ demo_info.team_2|length }} 人）
      <p style="color: var(--color-text-secondary); margin: var(--space-xs) 0 0 0;">
        {{ demo_info.team_2|join('、') or '—' }}
      </p>
    </div>
    <div>
      <strong>Team 3</strong>（{{ demo_info.team_3|length }} 人）
      <p style="color: var(--color-text-secondary); margin: var(--space-xs) 0 0 0;">
        {{ demo_info.team_3|join('、') or '—' }}
      </p>
    </div>
  </div>
  <p style="color: var(--color-text-secondary); font-size: 0.9em; margin: var(--space-sm) 0 0 0;">
    共 {{ demo_info.player_count }} 名玩家 — 文件选对了！
  </p>
</div>
{% endif %}

<!-- HTMX polls every 5 seconds -->
<div id="progress-panel"
     hx-get="/progress/{{ job_id }}/status"
     hx-trigger="every 5s"
     hx-swap="innerHTML">
  <ul class="stage-list">
    <li class="stage-pending">⬜ 提取语音</li>
    <li class="stage-pending">⬜ 语音转写</li>
    <li class="stage-pending">⬜ 加载词典</li>
    <li class="stage-pending">⬜ 识别回合</li>
    <li class="stage-pending">⬜ 识别球员</li>
    <li class="stage-pending">⬜ LLM 翻译</li>
    <li class="stage-pending">⬜ 生成字幕</li>
  </ul>
</div>

<div style="margin-top: var(--space-xl); padding: var(--space-lg); background: var(--color-bg-secondary); border-radius: var(--radius-md);">
  <p style="color: var(--color-text-secondary); font-size: 0.9em;">
    ⏳ 管线正在后台运行中。你可以：
  </p>
  <ul style="color: var(--color-text-secondary); font-size: 0.9em;">
    <li>切换到 <a href="/glossary">词典</a> 标签页编辑术语</li>
    <li>刷新此页面 — 进度不会丢失</li>
    <li>关闭浏览器 — 下次打开时重新导入即可</li>
  </ul>
  <p style="color: var(--color-text-secondary); font-size: 0.85em;">
    💡 这是在办公本上运行？翻译过程中 UI 不会消耗额外 CPU — 全部算力留给 Whisper 和 LLM。
  </p>
</div>

<!-- Auto-redirect when done -->
<div hx-get="/progress/{{ job_id }}/status"
     hx-trigger="every 5s"
     hx-swap="none"
     id="completion-watcher">
</div>
<script>
  document.getElementById('completion-watcher').addEventListener('htmx:afterOnLoad', function(evt) {
    const text = evt.detail.xhr.responseText;
    if (text.includes('stage-done') && !text.includes('stage-current') && !text.includes('stage-error')) {
      window.location.href = '/preview/{{ job_id }}';
    }
  });
</script>
{% endblock %}
