<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CS2 POV Translator</title>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <style>
    /* ── Pico.css v2.1.1 (inline, ~83KB) ── */
    {{ pico_css | safe }}
  </style>
  <style>
    /* ── CS2 Brand overrides (after Pico.css to win specificity) ── */
    :root {
      --pico-primary: #e94560;
      --pico-primary-hover: #c03a50;
      --pico-primary-focus: rgba(233, 69, 96, 0.25);
      --pico-primary-inverse: #ffffff;
      --pico-background-color: #1a1a2e;
      --pico-font-family: 'Microsoft YaHei UI', 'PingFang SC', 'Noto Sans SC', sans-serif;
      --pico-border-radius: 4px;
      --pico-form-element-spacing-vertical: 8px;
      --pico-form-element-spacing-horizontal: 16px;
      --pico-nav-background-color: #16213e;
      --color-bg-secondary: #16213e;
      --color-border: #2a2a4a;
      --color-selected: rgba(233, 69, 96, 0.15);
      /* Legacy aliases for templates not yet updated */
      --color-accent: var(--pico-primary);
      --color-text-secondary: #a0a0b0;
      --color-bg-primary: var(--pico-background-color);
      --color-success: #4ade80;
    }

    /* ── Layout ── */
    main.container {
      max-width: 1400px;
      margin: 0 auto;
      padding: var(--pico-spacing);
    }

    /* ── Nav tabs ── */
    nav.tabs {
      background: var(--pico-nav-background-color);
      border-bottom: 1px solid var(--color-border);
    }
    nav.tabs ul {
      margin: 0 auto;
      max-width: 1400px;
      padding: 0 var(--pico-spacing);
      display: flex;
      gap: 0;
      list-style: none;
    }
    nav.tabs a {
      display: block;
      color: #a0a0b0;
      text-decoration: none;
      padding: var(--pico-spacing) calc(var(--pico-spacing) * 1.5);
      border-bottom: 2px solid transparent;
      font-size: 0.95em;
      transition: color 0.15s, border-color 0.15s;
    }
    nav.tabs a:hover { color: #eaeaea; }
    nav.tabs a.active {
      color: var(--pico-primary);
      border-bottom-color: var(--pico-primary);
    }
    nav.tabs a.disabled { opacity: 0.4; cursor: default; }

    /* ── Progress stages ── */
    .stage-list { list-style: none; padding: 0; }
    .stage-list li {
      padding: var(--pico-spacing);
      margin-bottom: 4px;
      border-radius: var(--pico-border-radius);
    }
    .stage-done { color: var(--pico-form-element-valid-active-color, #4ade80); }
    .stage-current {
      color: var(--pico-color);
      background: var(--color-bg-secondary);
    }
    .stage-pending { color: #a0a0b0; }
    .stage-error { color: var(--pico-del-color, #e94560); }
    .stage-error-detail {
      color: var(--pico-del-color, #e94560);
      padding: var(--pico-spacing);
    }
    .stage-error-detail .hint { color: #a0a0b0; font-size: 0.9em; }
    .stage-detail { color: #a0a0b0; font-size: 0.85em; margin-left: var(--pico-spacing); }

    /* ── Chat messages ── */
    .chat-message {
      padding: var(--pico-spacing);
      margin-bottom: var(--pico-spacing);
      border-radius: var(--pico-border-radius);
      cursor: pointer;
      transition: background 0.1s;
    }
    .chat-message:hover { background: var(--color-bg-secondary); }
    .chat-message.selected {
      border: 1px solid var(--pico-primary);
      background: var(--color-selected);
    }
    .msg-header {
      display: flex;
      align-items: center;
      gap: var(--pico-spacing);
      margin-bottom: 4px;
    }
    .msg-player { font-weight: 600; color: var(--pico-primary); }
    .msg-time { color: #a0a0b0; font-size: 0.85em; font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace; }
    .msg-original { color: #a0a0b0; font-size: 0.85em; margin-bottom: 4px; }
    .msg-translated { color: var(--pico-color); }
    .edited-mark { font-size: 0.8em; }

    /* ── Glossary card list ── */
    .glossary-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--pico-spacing);
    }
    .glossary-card h4 { margin-top: 0; color: var(--pico-primary); }
    .glossary-card .aliases { color: #a0a0b0; font-size: 0.85em; }
    .glossary-card .card-actions {
      margin-top: var(--pico-spacing);
      display: flex;
      gap: var(--pico-spacing);
      justify-content: flex-end;
    }

    /* ── Upload zone ── */
    .upload-zone {
      padding: var(--pico-spacing);
      border: 2px dashed var(--color-border);
      border-radius: var(--pico-border-radius);
      text-align: center;
      cursor: pointer;
      transition: border-color 0.15s;
    }
    .upload-zone:hover { border-color: var(--pico-primary); }

    /* ── Stats card ── */
    .stats-card {
      background: var(--color-bg-secondary);
      padding: var(--pico-spacing);
      border-radius: var(--pico-border-radius);
    }

    /* ── Settings ── */
    .settings-section {
      background: var(--color-bg-secondary);
      padding: var(--pico-spacing);
      border-radius: var(--pico-border-radius);
      margin-bottom: var(--pico-spacing);
    }
    .settings-section h3 { margin-top: 0; margin-bottom: var(--pico-spacing); }
    .save-success { color: #4ade80; padding: var(--pico-spacing); }
    .save-error { color: var(--pico-primary); padding: var(--pico-spacing); }
    .config-warning {
      background: var(--color-bg-secondary);
      padding: var(--pico-spacing);
      margin-bottom: var(--pico-spacing);
      border-radius: var(--pico-border-radius);
      border: 1px solid var(--color-border);
      color: #a0a0b0;
    }

    /* ── Modal dialog for edit panel ── */
    dialog.edit-dialog {
      background: #1a1a2e;
      color: var(--pico-color);
      border: 1px solid var(--pico-primary);
      border-radius: var(--pico-border-radius);
      padding: var(--pico-spacing);
      max-width: 560px;
      width: 90vw;
    }
    dialog.edit-dialog::backdrop {
      background: rgba(0, 0, 0, 0.6);
    }
    dialog.edit-dialog textarea {
      width: 100%;
      min-height: 80px;
      margin-bottom: var(--pico-spacing);
    }

    /* ── Badges ── */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: var(--pico-border-radius);
      font-size: 0.8em;
      font-weight: 600;
    }
    .badge-zone, .badge-bombsite { background: #e945601a; color: var(--pico-primary); }
    .badge-spawn { background: #f59e0b1a; color: #f59e0b; }
    .badge-landmark { background: #4ade801a; color: #4ade80; }
    .badge-position { background: #38bdf81a; color: #38bdf8; }
    .badge-nade { background: #c084fc1a; color: #c084fc; }
    .badge-weapon { background: #ef44441a; color: #ef4444; }
    .badge-utility { background: #fb923c1a; color: #fb923c; }
    .badge-tactic { background: #a78bfa1a; color: #a78bfa; }
    .badge-user, .badge-other { background: #a0a0b01a; color: #a0a0b0; }

    /* ── Visited link distinction ── */
    a:visited { color: #c03a50; }

    /* ── Responsive breakpoints ── */
    @media (max-width: 1023px) {
      main.container { padding: var(--pico-spacing); }
      .glossary-card-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 767px) {
      nav.tabs a {
        padding: var(--pico-spacing);
        font-size: 0.85em;
      }
      dialog.edit-dialog {
        width: 100vw;
        max-width: 100vw;
        margin: 0;
        border-radius: 0;
      }
      .stats-card ul { padding-left: var(--pico-spacing); }
      .form-grid-2 { grid-template-columns: 1fr !important; }
    }
  </style>
</head>
<body>
  <nav class="tabs" role="tablist">
    <ul>
      <li><a href="/import" role="tab" {% if active_tab == 'import' %}aria-selected="true" class="active"{% endif %}><span aria-hidden="true">📥</span> 导入</a></li>
      {% set nav_job_id = job_id if job_id else last_job_id %}
      {% if nav_job_id %}
      <li><a href="/preview/{{ nav_job_id }}" role="tab" {% if active_tab == 'preview' %}aria-selected="true" class="active"{% endif %}><span aria-hidden="true">💬</span> 预览</a></li>
      <li><a href="/export/{{ nav_job_id }}" role="tab" {% if active_tab == 'export' %}aria-selected="true" class="active"{% endif %}><span aria-hidden="true">📤</span> 导出</a></li>
      {% else %}
      <li><a role="tab" class="disabled" title="导入 demo 后可用" aria-disabled="true"><span aria-hidden="true">💬</span> 预览</a></li>
      <li><a role="tab" class="disabled" title="导入 demo 后可用" aria-disabled="true"><span aria-hidden="true">📤</span> 导出</a></li>
      {% endif %}
      <li><a href="/glossary" role="tab" {% if active_tab == 'glossary' %}aria-selected="true" class="active"{% endif %}><span aria-hidden="true">📖</span> 词典</a></li>
      <li><a href="/settings" role="tab" {% if active_tab == 'settings' %}aria-selected="true" class="active"{% endif %}><span aria-hidden="true">⚙️</span> 设置</a></li>
    </ul>
  </nav>
  <main class="container">
    {% block content %}{% endblock %}
  </main>
  <script>
    // Ensure load-more sentinels are reprocessed after any HTMX swap.
    document.body.addEventListener('htmx:afterSettle', function() {
      var sentinel = document.getElementById('load-more');
      if (sentinel) { htmx.process(sentinel); }
    });

    // ── Glossary inline edit ──
    var _glossEditingIndex = -1;
    function editGlossaryTerm(index) {
      var row = document.getElementById('term-' + index);
      if (!row) return;
      if (_glossEditingIndex >= 0) {
        delete window['_glossBackup' + _glossEditingIndex];
      }
      _glossEditingIndex = index;
      window['_glossBackup' + index] = row.outerHTML;
      htmx.ajax('GET', '/glossary/edit/' + index, {target: '#term-' + index, swap: 'outerHTML'});
    }
    function cancelGlossaryEdit(index) {
      var backup = window['_glossBackup' + index];
      if (!backup) return;
      var row = document.getElementById('term-' + index);
      if (row) { row.outerHTML = backup; }
      htmx.process(document.getElementById('term-' + index));
      delete window['_glossBackup' + index];
      _glossEditingIndex = -1;
    }
  </script>
</body>
</html>
