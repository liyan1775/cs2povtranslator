{% extends "base.html.j2" %}
{% block content %}
<h1>设置</h1>

{% if config_error %}
<div class="config-warning">
  {{ config_error }}
</div>
{% endif %}

<form id="settings-form" hx-post="/settings" hx-swap="outerHTML" hx-target="#save-status">

  <!-- ── Whisper ── -->
  <div class="settings-section">
    <h3>Whisper 语音识别模型</h3>
    <div class="form-grid-2">
      <div>
        <label for="whisper_model">模型大小</label>
        <select name="whisper_model" id="whisper_model">
          {% for m in valid_whisper_models %}
          <option value="{{ m }}" {% if m == whisper_model %}selected{% endif %}>{{ m }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label for="whisper_device">运行设备</label>
        <select name="whisper_device" id="whisper_device">
          <option value="auto" {% if whisper_device == 'auto' %}selected{% endif %}>auto（自动选择）</option>
          <option value="cpu" {% if whisper_device == 'cpu' %}selected{% endif %}>cpu</option>
          <option value="cuda" {% if whisper_device == 'cuda' %}selected{% endif %}>cuda（NVIDIA GPU）</option>
        </select>
      </div>
    </div>
    <p class="hint">
      模型首次使用时自动从 HuggingFace 下载。越大的模型准确率越高，但速度越慢、占用内存越多。
      <strong>tiny</strong> 适合低配机器，<strong>base</strong> 平衡速度和准确率，<strong>large-v3</strong> 效果最好。
    </p>
  </div>

  <!-- ── LLM ── -->
  <div class="settings-section">
    <h3>LLM 翻译配置</h3>
    <div class="form-grid-2">
      <div>
        <label for="llm_provider">提供商</label>
        <select name="llm_provider" id="llm_provider">
          {% for p in valid_llm_providers %}
          <option value="{{ p }}" {% if p == llm_provider %}selected{% endif %}>{{ p }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label for="llm_model">模型名称</label>
        <input type="text" name="llm_model" id="llm_model"
               value="{{ llm_model }}"
               placeholder="如：deepseek-chat, gpt-4o, claude-sonnet-4-6">
      </div>
      <div>
        <label for="llm_api_key">API Key <span class="form-label-hint">（留空不修改）</span></label>
        <input type="password" name="llm_api_key" id="llm_api_key"
               value=""
               placeholder="留空则不修改现有密钥"
               autocomplete="new-password">
      </div>
      <div>
        <label for="llm_base_url">Base URL <span class="form-label-hint">（可选）</span></label>
        <input type="text" name="llm_base_url" id="llm_base_url"
               value="{{ llm_base_url }}"
               placeholder="留空使用默认；DeepSeek: https://api.deepseek.com/v1">
      </div>
    </div>
    <p class="hint">
      使用 DeepSeek：提供商选 <strong>openai</strong>，Base URL 填 <code>https://api.deepseek.com/v1</code>，模型填 <code>deepseek-chat</code>。
      API Key 留空则保持已有密钥不变。
    </p>
  </div>

  <!-- ── Prompt ── -->
  <div class="settings-section">
    <h3>翻译提示词模板</h3>
    <textarea name="prompt_template" id="prompt_template" rows="16"
              class="form-mono-input"
    >{{ prompt_template }}</textarea>
    <p class="hint">
      可用占位符：<code>{'{target_language}'}</code> — 目标语言，
      <code>{'{term_table_section}'}</code> — 词典术语表，
      <code>{'{voice_lines}'}</code> — 待翻译语音行。
      <strong>{'{voice_lines}'}</strong> 为必填占位符。
    </p>
    <div class="form-row-tight">
      <button type="button"
              hx-post="/settings"
              hx-vals='{"action":"reset_prompt"}'
              hx-target="#save-status"
              hx-swap="outerHTML"
              class="btn-secondary"
              {% if not prompt_is_custom %}disabled{% endif %}>
        恢复默认提示词
      </button>
      {% if not prompt_is_custom %}
      <span class="form-label-hint" style="align-self:center;">当前使用默认提示词</span>
      {% endif %}
    </div>
  </div>

  <!-- ── Save ── -->
  <div class="form-row">
    <input type="hidden" name="action" value="save">
    <button type="submit" class="btn-primary">
      保存设置
    </button>
    <span id="save-status"></span>
  </div>

</form>
{% endblock %}
