{% extends "base.html.j2" %}
{% block content %}
<h1>翻译预览</h1>

<!-- Team selector -->
<div style="display:flex;gap:var(--pico-spacing);margin-bottom:var(--pico-spacing);align-items:center;flex-wrap:wrap;">
  <select id="team-select"
          hx-get="/preview/{{ job_id }}"
          hx-target="#message-flow"
          hx-swap="innerHTML"
          name="team"
          hx-trigger="change">
    <option value="2" {% if team == '2' %}selected{% endif %}>Team 2 ({{ team_2_count }} 条)</option>
    <option value="3" {% if team == '3' %}selected{% endif %}>Team 3 ({{ team_3_count }} 条)</option>
  </select>
  <span style="color:#a0a0b0;font-size:0.9em;">共 {{ total }} 条消息</span>
</div>

<!-- Message flow (single column) -->
<div id="message-flow" role="log" style="max-width:900px;">
  {{ messages_html | safe }}

  {% if has_more %}
  <div id="load-more"
       hx-get="/preview/{{ job_id }}?team={{ team }}&offset={{ next_offset }}&limit=50"
       hx-trigger="intersect once"
       hx-swap="outerHTML"
       style="text-align:center;padding:var(--pico-spacing);color:#a0a0b0;">
    加载更多消息...
  </div>
  {% endif %}
</div>

<!-- Edit dialog (Pico.css modal) -->
<dialog id="edit-dialog" class="edit-dialog">
  <article>
    <header>
      <h3 style="margin:0;">编辑译文</h3>
    </header>
    <p id="edit-original" style="color:#a0a0b0;font-size:0.9em;"></p>
    <form id="edit-form" hx-post="" hx-swap="outerHTML">
      <textarea id="edit-translated" name="translated_text" rows="3"></textarea>
      <div style="display:flex;gap:var(--pico-spacing);">
        <button type="submit">💾 保存</button>
        <button type="button" onclick="closeEditor()" class="secondary">取消</button>
      </div>
    </form>
    <footer style="color:#a0a0b0;font-size:0.8em;margin-top:var(--pico-spacing);">
      💡 点击左侧消息即可编辑译文。编辑后的文本将用于 SRT 导出。
    </footer>
  </article>
</dialog>

{% if total == 0 %}
<div class="empty-state" style="text-align:center;padding:var(--pico-spacing);color:#a0a0b0;">
  <p><strong>此 demo 无语音数据</strong></p>
  <p>该 demo 中没有检测到语音通信，或者翻译尚未完成。</p>
  <a href="/import" role="button" class="secondary">导入新 demo</a>
</div>
{% endif %}

<script>
  // ── Preview message edit (modal dialog) ──
  function openEditor(index, el) {
    document.querySelectorAll('.chat-message').forEach(function(m) { m.classList.remove('selected'); });
    el.classList.add('selected');
    var dialog = document.getElementById('edit-dialog');
    if (!dialog) return;
    var seg = document.getElementById('msg-' + index);
    var orig = seg ? seg.querySelector('.msg-original')?.textContent || '' : '';
    var trans = seg ? seg.querySelector('.msg-translated')?.textContent || '' : '';
    dialog.querySelector('#edit-original').textContent = orig;
    dialog.querySelector('#edit-translated').value = trans;
    dialog.querySelector('#edit-form').setAttribute('hx-post', '/preview/{{ job_id }}/edit/' + index);
    dialog.querySelector('#edit-form').setAttribute('hx-target', '#msg-' + index);
    dialog.showModal();
  }
  function closeEditor() {
    var dialog = document.getElementById('edit-dialog');
    if (dialog) dialog.close();
  }
</script>
{% endblock %}
