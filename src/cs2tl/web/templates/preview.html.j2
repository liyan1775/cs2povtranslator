{% extends "base.html.j2" %}
{% block content %}
<div class="preview-grid">

  <!-- Left: Team selector -->
  <aside class="team-sidebar">
    <button hx-get="/preview/{{ job_id }}?team=2&offset=0&limit=50"
            hx-target="#message-flow" hx-swap="innerHTML"
            onclick="document.querySelectorAll('.team-sidebar button').forEach(b=>b.classList.remove('active'));this.classList.add('active');"
            class="{% if team == '2' %}active{% endif %}">
      Team 2<br><small>{{ team_2_count }} 条</small>
    </button>
    <button hx-get="/preview/{{ job_id }}?team=3&offset=0&limit=50"
            hx-target="#message-flow" hx-swap="innerHTML"
            onclick="document.querySelectorAll('.team-sidebar button').forEach(b=>b.classList.remove('active'));this.classList.add('active');"
            class="{% if team == '3' %}active{% endif %}">
      Team 3<br><small>{{ team_3_count }} 条</small>
    </button>
    <div style="margin-top: var(--space-lg); color: var(--color-text-secondary); font-size: 0.85em;">
      共 {{ total }} 条消息
    </div>
  </aside>

  <!-- Center: Message flow -->
  <div id="message-flow" class="message-flow" role="log">
    {{ messages_html | safe }}

    {% if has_more %}
    <div hx-get="/preview/{{ job_id }}?team={{ team }}&offset={{ next_offset }}&limit=50"
         hx-trigger="revealed"
         hx-swap="outerHTML"
         style="text-align:center;padding:var(--space-md);color:var(--color-text-secondary);">
      加载更多消息...
    </div>
    {% endif %}
  </div>

  <!-- Right: Edit panel -->
  <aside id="edit-panel" class="edit-panel" style="display:none;">
    <h3 style="margin-top:0;">编辑译文</h3>
    <p id="edit-original" style="color:var(--color-text-secondary);font-size:0.9em;"></p>
    <form id="edit-form" hx-post="" hx-swap="outerHTML">
      <textarea id="edit-translated" name="translated_text" rows="3"></textarea>
      <div style="display:flex;gap:var(--space-sm);">
        <button type="submit">💾 保存</button>
        <button type="button" onclick="document.getElementById('edit-panel').style.display='none'"
                style="background:var(--color-bg-secondary);">取消</button>
      </div>
    </form>
    <p style="color:var(--color-text-secondary);font-size:0.8em;margin-top:var(--space-md);">
      💡 点击左侧消息即可编辑译文。<br>
      编辑后的文本将用于 SRT 导出。
    </p>
  </aside>

</div>

{% if total == 0 %}
<div class="empty-state">
  <p>还没有翻译结果。</p>
  <p style="color: var(--color-text-secondary);">
    翻译可能还在进行中——请切换到进度页查看状态。
  </p>
</div>
{% endif %}
{% endblock %}
